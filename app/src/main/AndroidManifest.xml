<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ARCore работает через камеру телефона -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Приложение "AR Required": Google Play покажет его только на устройствах с поддержкой ARCore -->
    <uses-feature
        android:name="android.hardware.camera.ar"
        android:required="true" />

    <!-- Рисуем через OpenGL ES 2.0 -->
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.ArTamagotchi">

        <!-- Говорит системе, что без "Сервисов Google Play для AR" приложение не работает -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="required" />

        <!-- Первый экран: выбор персонажа -->
        <activity
            android:name=".SelectActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AR-экран. Портретная ориентация: так проще для первого прототипа -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>

</manifest>

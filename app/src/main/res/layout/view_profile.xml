<?xml version="1.0" encoding="utf-8"?>
<!-- Поля профиля: общий кусок для экрана выбора и для настроек -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView style="@style/FormLabel" android:text="@string/form_hero_name" />
    <EditText
        android:id="@+id/edit_hero_name"
        style="@style/FormEdit"
        android:hint="@string/form_hero_name"
        android:importantForAutofill="no"
        android:inputType="textCapWords"
        android:maxLength="16" />

    <TextView style="@style/FormLabel" android:text="@string/form_player_name" />
    <EditText
        android:id="@+id/edit_player_name"
        style="@style/FormEdit"
        android:hint="@string/form_player_hint"
        android:importantForAutofill="no"
        android:inputType="textCapWords"
        android:maxLength="20" />

    <TextView style="@style/FormLabel" android:text="@string/form_player_gender" />
    <Spinner
        android:id="@+id/spinner_player_gender"
        android:layout_width="match_parent"
        android:layout_height="48dp" />

    <TextView style="@style/FormLabel" android:text="@string/form_personality" />
    <Spinner
        android:id="@+id/spinner_personality"
        android:layout_width="match_parent"
        android:layout_height="48dp" />
</LinearLayout>
